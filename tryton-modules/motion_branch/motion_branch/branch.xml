<tryton>
    <data grouped="1">
        <record model="ir.message" id="msg_branch_code_unique">
            <field name="text">The branch code must be unique per company.</field>
        </record>
        <record model="ir.message" id="msg_branch_warehouse_unique">
            <field name="text">A warehouse can belong to only one branch.</field>
        </record>
    </data>
    <data>
        <record model="ir.ui.view" id="branch_view_form">
            <field name="model">motion.branch</field>
            <field name="type">form</field>
            <field name="name">branch_form</field>
        </record>
        <record model="ir.ui.view" id="branch_view_list">
            <field name="model">motion.branch</field>
            <field name="type">tree</field>
            <field name="name">branch_list</field>
        </record>
        <record model="ir.action.act_window" id="act_branch">
            <field name="name">Branches</field>
            <field name="res_model">motion.branch</field>
        </record>
        <record model="ir.action.act_window.view" id="act_branch_view_list">
            <field name="sequence" eval="10"/>
            <field name="view" ref="branch_view_list"/>
            <field name="act_window" ref="act_branch"/>
        </record>
        <record model="ir.action.act_window.view" id="act_branch_view_form">
            <field name="sequence" eval="20"/>
            <field name="view" ref="branch_view_form"/>
            <field name="act_window" ref="act_branch"/>
        </record>
        <menuitem parent="company.menu_company" action="act_branch"
            sequence="30" id="menu_branch"/>

        <record model="ir.model.access" id="access_branch">
            <field name="model">motion.branch</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_branch_admin">
            <field name="model">motion.branch</field>
            <field name="group" ref="res.group_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
        <record model="ir.model.access" id="access_configuration">
            <field name="model">motion.configuration</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_delete" eval="False"/>
        </record>
        <record model="ir.model.access" id="access_configuration_admin">
            <field name="model">motion.configuration</field>
            <field name="group" ref="account.group_account_admin"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_delete" eval="True"/>
        </record>
    </data>
</tryton>
